# =============================================================================
# Konfiguration Foto-Workflow-Server
# Kopiere diese Datei nach ".env" und trage deine echten Werte ein.
# Die .env-Datei NIEMALS ins Internet stellen oder in Git einchecken!
# =============================================================================

# ---- Öffentliche Adresse des Servers ----
# Öffentliche IPv4-Adresse deines VPS (wichtig für FTP Passive Mode!)
VPS_PUBLIC_IP=2.28.64.14

# Domain, unter der das Dashboard erreichbar sein soll (für automatisches HTTPS)
DASHBOARD_DOMAIN=foto.christianspreitz.de
# E-Mail für Let's Encrypt-Benachrichtigungen
ACME_EMAIL=deine-email@example.com

# ---- FTP-Zugang für die Kamera (Canon R1 -> dieser Server) ----
CAMERA_FTP_USER=canon
CAMERA_FTP_PASS=bitte-sicheres-passwort-eintragen

# ---- Dashboard-Login (nur du) ----
APP_USERNAME=chris
APP_PASSWORD=bitte-sicheres-passwort-eintragen
# Zufälliger, langer String zum Signieren der Login-Session
SESSION_SECRET=bitte-langen-zufallsstring-eintragen

# ---- Ziel-FTP der Redaktion ----
REDAKTION_FTP_HOST=ftp.redaktion-beispiel.de
REDAKTION_FTP_PORT=21
REDAKTION_FTP_USER=nutzername
REDAKTION_FTP_PASS=passwort
# Nutze FTPS (verschlüsselt), falls die Redaktion das unterstützt: true/false
REDAKTION_FTP_USE_TLS=false
# Zielordner auf dem Redaktions-FTP (leer lassen = Hauptverzeichnis)
REDAKTION_FTP_REMOTE_DIR=

# ---- IPTC-Beschriftung ----
PHOTOGRAPHER_NAME=Chris
COPYRIGHT_NOTICE=© Chris / BILD
DEFAULT_CREDIT=BILD

# ---- Workflow-Verhalten ----
AUTO_FORWARD_DELAY_SECONDS=8
FACE_RECOGNITION_ENABLED=true
FACE_MATCH_TOLERANCE=0.5
